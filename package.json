{
  "name": "3bp",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:version": "node scripts/versioningRegression.mjs",
    "check:physics": "node scripts/runPhysicsRegression.mjs",
    "build": "npm run check:version && npm run check:physics && tsc -b && vite build",
    "preview": "vite preview",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
